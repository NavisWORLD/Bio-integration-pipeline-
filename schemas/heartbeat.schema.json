{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NavisWORLD/Bio-integration-pipeline-/schemas/heartbeat.schema.json",
  "title": "COSMOS Heartbeat Record",
  "type": "object",
  "required": ["cosmos_id", "boot_id", "sequence", "state", "bio_confidence", "runtime_health", "timestamp", "schema"],
  "properties": {
    "schema": {"const": "cosmos.heartbeat.v1"},
    "cosmos_id": {"type": "string"},
    "boot_id": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 1},
    "bio_frame_id": {"type": ["string", "null"]},
    "bio_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "memory_revision": {"type": "integer", "minimum": 0},
    "model_revision": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "runtime_health": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "state": {
      "type": "object",
      "required": ["vector", "dimensions", "revision", "confidence", "timestamp"],
      "properties": {
        "vector": {"type": "array", "items": {"type": "number"}},
        "dimensions": {"type": "integer", "minimum": 1},
        "revision": {"type": "integer", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    }
  }
}
